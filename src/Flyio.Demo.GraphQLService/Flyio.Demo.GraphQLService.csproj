<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <SchemaDir>$(MSBuildProjectDirectory)/../../tests/Flyio.Demo.GraphQLService.Tests/Client</SchemaDir>
  </PropertyGroup>

  <Target Name="ExportGraphQLSchema" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Message Text="Exportando schema GraphQL para $(SchemaDir)" Importance="high" />

    <Exec Command="dotnet &quot;$(TargetDir)$(TargetName).dll&quot; schema export --output &quot;$(SchemaDir)/schema.graphql&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore"/>
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
    <PackageReference Include="HotChocolate.Diagnostics" />
    <PackageReference Include="HotChocolate.Types.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flyio.Demo.Todos\Flyio.Demo.Todos.csproj" />
  </ItemGroup>

</Project>
