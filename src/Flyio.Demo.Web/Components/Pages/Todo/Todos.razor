@page "/todos"
@attribute [StreamRendering(true)]
@attribute [Authorize(Roles = "apiservice:viewer")]

@inject ApiServiceApiClient Client

<h3>Todos</h3>

<a href="/todos/create" class="btn btn-primary mb-3">
    Novo
</a>

@if (todos == null)
{
    <p>Carregando...</p>
}
else
{
    <EditForm Enhance FormName="SearchTodos" Model="@Model" OnValidSubmit="HandleSearch">
        <InputText @bind-Value="Model!.Search" placeholder="Pesquise por algum texto.." />

        <button type="submit" class="btn btn-success">
            Pesquisar
        </button>
    </EditForm>

    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Criado em</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var todo in todos)
            {
                <tr>
                    <td>@todo.Name</td>
                    <td>@todo.CreatedAt</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="/todos/edit/@todo.Id">
                            Editar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromForm]
    public SearchModel? Model { get; set; }
   
    private GetAllTodosResponse[]? todos;

    protected override async Task OnInitializedAsync()
    {
        Model ??= new();
        todos = await Client.GetAllTodosAsync(Model.Search);
    }

    private async Task HandleSearch()
    {
        todos = await Client.GetAllTodosAsync(Model!.Search);
    }

    public class SearchModel
    {
        public string Search { get; set; } = default!;
    }
}