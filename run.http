# @name login

POST https://localhost:8080/realms/local/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
&client_id=demo-confidential
&client_secret=secret

###

@token = {{login.response.body.$.access_token}} 

###

GET https://localhost:7386/v1/todos
Authorization: Bearer {{token}}

###

GET https://localhost:7386/whoami
Authorization: Bearer {{token}}

###

POST https://localhost:7386/v1/todos
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "teste"
}

###

POST https://localhost:7386/v1/todos/c2d174e7-3ca8-438c-ac01-c27979e5e951:done
Authorization: Bearer {{token}}
